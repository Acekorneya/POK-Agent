{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POK-Agent",
  "version": "0.1.0",
  "identifier": "ai.pok.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1430", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "POK-Agent", "width": 980, "height": 700, "minWidth": 640, "minHeight": 520 }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE",
      "../../../scripts/laya_sidecar.py": "scripts/laya_sidecar.py",
      "../../../scripts/setup-laya.ps1": "scripts/setup-laya.ps1",
      "../../../scripts/zeiger_sidecar.py": "scripts/zeiger_sidecar.py",
      "../../../scripts/setup-zeiger.ps1": "scripts/setup-zeiger.ps1"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
